# 이 파일은 "예시"입니다. 실제 값은 넣지 마세요. 실제 값은 .env(커밋 금지) 또는
# Netlify 대시보드의 Environment variables에 넣습니다.

# 브라우저에서 사용하는 공개 값 (anon 키는 공개되어도 되는 키)
# 프런트엔드 코드에 들어가며, Supabase RLS로 보호됩니다.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# 서버 함수에서만 사용하는 비밀 값 (절대 브라우저/저장소에 넣지 말 것)
# netlify/functions/guestbook.mjs 에서만 사용. Netlify 대시보드에만 설정.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
